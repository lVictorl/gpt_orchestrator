<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GPT-Orchestrator — {{ title }}</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
<style>
  :root {
    --bg: #0d1117;
    --surface: #161b22;
    --border: #30363d;
    --accent: #388bfd;
    --text: #e6edf3;
    --muted: #8b949e;
    --success: #3fb950;
    --error: #f85149;
  }
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font-family: 'JetBrains Mono', monospace; }
  .sidebar { position: fixed; left: 0; top: 0; width: 240px; height: 100vh; background: var(--surface); border-right: 1px solid var(--border); overflow-y: auto; padding: 1.5rem 1rem; }
  .main-content { margin-left: 260px; padding: 2rem; }
  .logo { font-size: 1.4rem; font-weight: bold; color: var(--accent); margin-bottom: 1.5rem; }
  .nav-item { padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 12px; color: var(--muted); margin-bottom: 2px; }
  .nav-item:hover { background: var(--border); color: var(--text); }
  .stage-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; margin-bottom: 2rem; overflow: hidden; }
  .stage-header { padding: 1rem 1.5rem; background: #21262d; display: flex; justify-content: space-between; align-items: center; }
  .stage-badge { background: #388bfd22; color: #79c0ff; border: 1px solid #388bfd44; border-radius: 6px; padding: 2px 10px; font-size: 11px; }
  .stage-body { padding: 1.5rem; }
  .section-title { color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; }
  pre { background: var(--bg) !important; border: 1px solid var(--border); border-radius: 6px; padding: 1rem; font-size: 12px; overflow-x: auto; }
  h1 { color: var(--accent); }
  .meta-badge { background: #21262d; color: var(--muted); border: 1px solid var(--border); border-radius: 4px; padding: 2px 8px; font-size: 11px; }
  .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .summary-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.5rem; text-align: center; }
  .summary-card .value { font-size: 2rem; font-weight: bold; color: var(--accent); }
  .summary-card .label { color: var(--muted); font-size: 12px; }
</style>
</head>
<body>

<nav class="sidebar">
  <div class="logo">🤖 GPT-Orchestrator</div>
  {% for stage in stages %}
  <div class="nav-item" onclick="document.getElementById('stage-{{loop.index}}').scrollIntoView({behavior:'smooth'})">
    {{ stage.label }} {{ stage.name }}
  </div>
  {% endfor %}
</nav>

<main class="main-content">
  <h1 class="mb-1">📊 Отчёт проекта</h1>
  <h4 class="text-secondary mb-1">{{ title }}</h4>
  <p class="text-secondary mb-4" style="font-size:12px;">Сгенерировано: {{ generated_at }}</p>

  <div class="summary-grid">
    <div class="summary-card">
      <div class="value">{{ stages|length }}</div>
      <div class="label">Этапов выполнено</div>
    </div>
    <div class="summary-card">
      <div class="value">{{ stages|sum(attribute='char_count') // 1000 }}K</div>
      <div class="label">Символов сгенерировано</div>
    </div>
  </div>

  {% for stage in stages %}
  <div class="stage-card" id="stage-{{loop.index}}">
    <div class="stage-header">
      <div>
        <span class="stage-badge">{{ stage.label }}</span>
        <strong class="ms-2">{{ stage.name }}</strong>
      </div>
      <span class="meta-badge">{{ stage.char_count }} символов</span>
    </div>
    <div class="stage-body">
      <div class="section-title">Запрос (промпт)</div>
      <pre><code class="language-text">{{ stage.prompt }}</code></pre>

      <div class="section-title mt-3">Ответ ИИ</div>
      <pre><code class="language-json">{{ stage.response }}</code></pre>
    </div>
  </div>
  {% endfor %}
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>hljs.highlightAll();</script>
</body>
</html>
